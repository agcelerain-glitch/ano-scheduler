# ===== Supabase =====
# プロジェクト設定 > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon public key（クライアント公開可）
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # service_role key（サーバー側のみ・絶対公開しない）

# DB 直接接続（マイグレーション実行用。Pooler=6543 transaction モード推奨）
DATABASE_URL=postgresql://postgres:[PASSWORD]@xxxx.pooler.supabase.com:6543/postgres

# ===== 管理者（Google ログイン）許可リスト =====
# カンマ区切り。ここに載っているメールアドレスだけが /admin にアクセス可能
ADMIN_EMAILS=you@example.com,teammate@example.com

# ===== レートリミット（Upstash Redis）=====
# 本番では必須。未設定だと書き込み系APIはフェイルクローズ（拒否）になる
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ===== サイト設定 =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000       # 本番は https://your-domain

# ===== Cron（期限切れイベント削除）=====
CRON_SECRET=generate-a-long-random-string
